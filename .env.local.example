# ============================================================================
# NOVA LIVE — Variables de Entorno (.env.local)
# IMPORTANTE DE SEGURIDAD: Pega tus llaves reales únicamente en .env.local,
# NUNCA en el código ni en el chat. Este archivo .env.local.example no contiene
# valores reales.
# ============================================================================

# 1. Stripe & Stripe Connect (Modo test: pk_test_ y sk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 2. Supabase (Cuentas, Perfiles, Historial de Transmisiones y Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. LiveKit Cloud (Video en Vivo y Voz WebRTC — SOLO en servidor .env.local)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
